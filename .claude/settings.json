{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(ruff *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m ruff *)",
      "Bash(pip install -r *)",
      "Bash(pip list)",
      "Bash(pip show *)",
      "Bash(python --version)",
      "Bash(python -c *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git stash*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(tree *)",
      "Bash(docker-compose config)",
      "Bash(docker-compose ps)",
      "Bash(docker compose config)",
      "Bash(docker compose ps)"
    ],
    "deny": [
      "Read(./api/.env)",
      "Read(./frontend/.env)",
      "Read(./api/gcp-key.json)",
      "Read(./api/instance/**)",
      "Bash(rm -rf *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
