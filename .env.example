# =============================================================================
# .env.example — Modèle des variables d'environnement Altarun
# =============================================================================
# Copier ce fichier en api/.env et frontend/.env (chacun ne prend que les
# variables qui le concernent). Ne jamais committer les .env réels.
#
# Le projet attend en plus le fichier api/gcp-key.json (clé de service Google
# Cloud pour l'accès BigQuery). Ce fichier doit être placé manuellement, il
# est gitignoré.
# =============================================================================


# -----------------------------------------------------------------------------
# COMMUN (à mettre dans api/.env ET frontend/.env)
# -----------------------------------------------------------------------------

# Token Bearer partagé entre l'API et le frontend pour authentifier les appels
# inter-services. Générer une chaîne longue et aléatoire (ex: openssl rand -hex 32).
API_TOKEN=changeme-shared-bearer-token


# -----------------------------------------------------------------------------
# API (à mettre dans api/.env)
# -----------------------------------------------------------------------------

# URL publique du frontend (utilisée dans les emails de reset de mot de passe).
APP_URL=http://localhost:5001

# Identifiants Gmail SMTP pour l'envoi des emails (reset de mot de passe).
# Pour Gmail : générer un "mot de passe d'application" dans les paramètres Google.
MAIL_USERNAME=ton.email@gmail.com
MAIL_PASSWORD=ton-mot-de-passe-application-gmail


# -----------------------------------------------------------------------------
# FRONTEND (à mettre dans frontend/.env)
# -----------------------------------------------------------------------------

# URL interne pour appeler l'API depuis le frontend.
# - En Docker : http://altarun_api:5000 (nom du service docker-compose)
# - En local sans Docker : http://localhost:5000
API_URL=http://altarun_api:5000

# URL du frontend (vue depuis le frontend lui-même).
APP_URL=http://localhost:5001

# URL publique du frontend (vue depuis l'extérieur, utilisée par Strava OAuth
# pour le redirect_uri du callback /exchange_token).
APP_PUBLIC_URL=http://localhost:5001

# Identifiants OAuth de l'application Strava
# (à créer sur https://www.strava.com/settings/api).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# SECRET_KEY_FRONT est généré automatiquement au premier démarrage du frontend
# (cf. frontend/services/config.py). Inutile de le renseigner ici.
# SECRET_KEY_FRONT=
